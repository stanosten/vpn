# App Configuration
APP_NAME="Async IP & VPN Node Checker"
APP_ENV=development
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000

# Concurrency & Network Limits
MAX_CONCURRENT_CHECKS=150
TIMEOUT_SECONDS=5.0
MAX_RETRIES=1
TCP_PING_TIMEOUT=3.0

# GeoIP & Enrichment
ENABLE_GEOIP=true
GEOIP_CACHE_TTL=86400

# Storage & Export
DB_PATH=data/nodes.db
OUTPUT_DIR=data/output
INPUT_SOURCES_FILE=data/input/sources.txt

# Git Auto-commit (optional for automated list updates)
AUTO_GIT_COMMIT=false
GIT_COMMIT_MESSAGE="chore: auto-update validated active nodes list [skip ci]"
GIT_REMOTE=origin
GIT_BRANCH=main
